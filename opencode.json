{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "instructions": [
    "docs/STATUS.md"
  ],
  "watcher": {
    "ignore": [
      "build/**",
      ".vs/**"
    ]
  },
  "permission": {
    "edit": {
      "*": "allow",
      "docs/*": "deny",
      "docs/**": "deny",
      "CLAUDE.md": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      ".gitattributes": "deny",
      ".claude/*": "deny",
      ".claude/**": "deny",
      "plans/README.md": "deny",
      "plans/_SABLON.md": "deny",
      "tools/*": "ask"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "git switch *": "allow",
      "git checkout -b *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "./tools/build.sh*": "allow",
      "tools/build.sh*": "allow",
      "bash tools/build.sh*": "allow",
      "git commit --amend*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask"
  },
  "agent": {
    "evidence": {
      "description": "Evidence collector for plan verification: runs commands and records raw results; never edits code, plans or docs.",
      "mode": "primary",
      "permission": {
        "edit": {
          "*": "deny",
          "plans/_logs/evidence/*": "allow",
          "plans/_logs/evidence/**": "allow"
        }
      }
    }
  }
}
